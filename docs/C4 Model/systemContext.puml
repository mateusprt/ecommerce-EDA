@startuml E-commerce System Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram - E-commerce Platform (Fase 1 - Monolito)

Person(customer, "Cliente", "Usuário que realiza compras online")

System(ecommerce, "E-commerce System", "Sistema de e-commerce que gerencia pedidos, pagamentos e estoque de forma monolítica")

System_Ext(credit_gateway, "Credit Gateway", "Gateway externo de processamento de pagamentos com cartão de crédito")
System_Ext(debit_gateway, "Debit Gateway", "Gateway externo de processamento de pagamentos com cartão de débito")

Rel(customer, ecommerce, "Cria pedidos, consulta status", "HTTP/REST")
Rel(ecommerce, credit_gateway, "Processa pagamentos de crédito", "HTTPS/API")
Rel(ecommerce, debit_gateway, "Processa pagamentos de débito", "HTTPS/API")


@enduml